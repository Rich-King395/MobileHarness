<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fixture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:saveEnabled="false">

    <TextView
        android:id="@+id/fixture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/title"
        android:textColor="#111111"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/fixture_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:contentDescription="@string/input_description"
        android:hint="@string/input_hint"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="text"
        android:saveEnabled="false"
        android:selectAllOnFocus="false"
        android:singleLine="true"
        android:text="initial" />

    <Button
        android:id="@+id/fixture_click"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/click_test" />

    <TextView
        android:id="@+id/fixture_click_count"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:textColor="#111111"
        android:textSize="16sp" />

    <Button
        android:id="@+id/fixture_long_press"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:longClickable="true"
        android:text="@string/long_press_test" />

    <TextView
        android:id="@+id/fixture_long_press_count"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:textColor="#111111"
        android:textSize="16sp" />

    <Button
        android:id="@+id/fixture_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/save_test" />

    <TextView
        android:id="@+id/fixture_save_state"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:textColor="#111111"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/fixture_saved_value"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="#111111"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/fixture_scroll_hint"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:text="@string/scroll_hint"
        android:textColor="#333333" />

    <ScrollView
        android:id="@+id/fixture_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EDF2F7"
        android:fillViewport="true"
        android:saveEnabled="false">

        <LinearLayout
            android:id="@+id/fixture_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:saveEnabled="false" />
    </ScrollView>
</LinearLayout>
